From 03ccd0e5d8bf3cf336fb5e6049fd1c2bac1c4dfe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 01:20:05 +0100
Subject: [PATCH] 0115

---
 bsd/dev/s9_power.c  | 25 +++++++++++++++++++++++++
 bsd/dev/sweet_ufs.c | 19 +++++++++++++++++++
 2 files changed, 44 insertions(+)

diff --git a/bsd/dev/s9_power.c b/bsd/dev/s9_power.c
index 55d447f..03eb2df 100644
--- a/bsd/dev/s9_power.c
+++ b/bsd/dev/s9_power.c
@@ -20,6 +20,8 @@
 #define S9_PMU_SIZE             0x4000
 #define S9_PMU_SWRESET          0x0400
 #define S9_PMU_SYSIP_DAT0       0x0810
+#define S9_PMU_INFORM2          0x0808  /* S-Boot: 0x12345678 + INFORM3 0x12345674 = recovery */
+#define S9_PMU_INFORM3          0x080c
 #define S9_PMU_PS_HOLD          0x330c
 
 #define PE_HALT_CPU             0       /* IOPlatformExpert.h kPEHaltCPU */
@@ -31,6 +33,29 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 static volatile uint32_t *s9_pmu;
 
 void s9_power_init(void);
+int s9_power_reboot_recovery(void);
+
+/*
+ * Restart into the recovery partition (TWRP), as the shim probes do: the
+ * S9's screen is broken, so test boots end themselves (boot-arg
+ * sweetrecovery=<seconds>, sweet_ufs.c, after the last log flush).
+ */
+int
+s9_power_reboot_recovery(void)
+{
+	if (s9_pmu == NULL) {
+		return -1;
+	}
+	(void)ml_set_interrupts_enabled(FALSE);
+	s9_pmu[S9_PMU_INFORM2 / 4] = 0x12345678;
+	s9_pmu[S9_PMU_INFORM3 / 4] = 0x12345674;
+	__builtin_arm_dsb(0xf);
+	s9_pmu[S9_PMU_SWRESET / 4] = 1;
+	__builtin_arm_dsb(0xf);
+	for (;;) {
+		__builtin_arm_wfi();
+	}
+}
 
 static int
 s9_halt_restart(unsigned int type)
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 825b1a6..3e7240f 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -823,7 +823,22 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 
 	printf("SWEET LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
 	    SWEET_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	/* sweetrecovery=<seconds>: save the log, then restart into TWRP (S9 with a dead screen) */
+	uint32_t recovery_secs = 0;
+	uint64_t recovery_deadline = 0;
+	int recovery_state = 0;         /* 1 = announced, waiting for the flush that carries it */
+	uint64_t recovery_pos = 0;
+	PE_parse_boot_argn("sweetrecovery", &recovery_secs, sizeof(recovery_secs));
+	if (recovery_secs != 0) {
+		clock_interval_to_deadline(recovery_secs, NSEC_PER_SEC, &recovery_deadline);
+		printf("SWEET LOG: restart into recovery after %u s\n", recovery_secs);
+	}
 	for (;;) {
+		if (recovery_deadline != 0 && recovery_state == 0 && mach_absolute_time() >= recovery_deadline) {
+			printf("SWEET LOG: %u s up, saving the log and restarting into recovery\n", recovery_secs);
+			recovery_state = 1;
+			recovery_pos = os_atomic_load(&sweet_log_total, relaxed);
+		}
 		(void)tsleep(&sweet_log_chan, PZERO, "sweetlog", hz * (int)sweet_log_secs);
 		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
 		if (total == flushed) {
@@ -868,6 +883,10 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 			printf("SWEET LOG: flush #%llu ok, %llu bytes logged\n", seq, total);
 		}
 		flushed = total;
+		if (recovery_state == 1 && flushed >= recovery_pos) {
+			extern int s9_power_reboot_recovery(void);
+			(void)s9_power_reboot_recovery();
+		}
 	}
 }
 
